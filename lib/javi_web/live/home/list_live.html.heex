<div
  class="relative flex size-full min-h-screen flex-col bg-[#141414] dark justify-between group/design-root overflow-x-hidden lg:ml-64"
  style='font-family: "Plus Jakarta Sans", "Noto Sans", sans-serif;'
>
  <.top_header title="Minhas Listas" right_click="show_create_modal" right_icon="hero-plus" />

  <div class="flex-1 overflow-y-auto pb-24 pt-20">
    <div class="px-4 lg:px-8 py-6 lg:py-8 max-w-7xl mx-auto">
      <!-- Default Lists Section -->
      <%= if length(@default_lists) > 0 do %>
        <div class="mb-8 lg:mb-12">
          <h3 class="text-white text-lg lg:text-xl font-semibold mb-4 lg:mb-6">Listas Padrão</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 lg:gap-6">
            <%= for list <- @default_lists do %>
              <div
                class="bg-[#212121] rounded-lg p-4 lg:p-6 hover:bg-[#2a2a2a] transition-colors border-l-4 border-blue-500 cursor-pointer"
                phx-click="navigate_to_list"
                phx-value-list-id={list.id}
              >
                <div class="flex justify-between items-start mb-3 lg:mb-4">
                  <h4 class="text-white text-lg lg:text-xl font-semibold">{list.name}</h4>
                  <div class="flex items-center gap-2">
                    <span class="text-xs lg:text-sm bg-blue-600 text-white px-2 py-1 rounded-full">
                      Padrão
                    </span>
                  </div>
                </div>

                <%= if list.description do %>
                  <p class="text-gray-400 text-sm lg:text-base mb-3 lg:mb-4">
                    {list.description}
                  </p>
                <% end %>

                <div class="flex items-center justify-between text-sm lg:text-base">
                  <span class="text-gray-500">
                    {length(list.list_items || [])} itens
                  </span>
                  <span class="text-gray-500">
                    {if list.is_public, do: "Público", else: "Privado"}
                  </span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
      
<!-- Custom Lists Section -->
      <div class="mb-8 lg:mb-12">
        <h3 class="text-white text-lg lg:text-xl font-semibold mb-4 lg:mb-6">Minhas Listas</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 lg:gap-6">
          <%= if length(@custom_lists) > 0 do %>
            <%= for list <- @custom_lists do %>
              <div
                class="bg-[#212121] rounded-lg p-4 lg:p-6 hover:bg-[#2a2a2a] transition-colors cursor-pointer"
                phx-click="navigate_to_list"
                phx-value-list-id={list.id}
              >
                <div class="flex justify-between items-start mb-3 lg:mb-4">
                  <h4 class="text-white text-lg lg:text-xl font-semibold">{list.name}</h4>
                  <div class="flex items-center gap-2">
                    <button
                      phx-click="show_edit_modal"
                      phx-value-id={list.id}
                      class="text-gray-400 hover:text-blue-500 transition-colors p-1"
                      data-confirm=""
                      phx-stop-propagation=""
                    >
                      <.icon name="hero-pencil-square" class="w-4 h-4 lg:w-5 lg:h-5" />
                    </button>
                    <button
                      phx-click="delete_list"
                      phx-value-id={list.id}
                      class="text-gray-400 hover:text-red-500 transition-colors p-1"
                      data-confirm="Tem certeza que deseja excluir esta lista?"
                      phx-stop-propagation=""
                    >
                      <.icon name="hero-trash" class="w-4 h-4 flex-shrink-0 lg:w-5 lg:h-5" />
                    </button>
                  </div>
                </div>

                <%= if list.description do %>
                  <p class="text-gray-400 text-sm lg:text-base mb-3 lg:mb-4">
                    {list.description}
                  </p>
                <% end %>

                <div class="flex items-center justify-between text-sm lg:text-base">
                  <span class="text-gray-500">
                    {length(list.list_items || [])} itens
                  </span>
                  <span class="text-gray-500">
                    {if list.is_public, do: "Público", else: "Privado"}
                  </span>
                </div>
              </div>
            <% end %>
          <% end %>
          
<!-- Create New List Card -->
          <div
            class="bg-[#212121] rounded-lg p-4 lg:p-6 hover:bg-[#2a2a2a] transition-colors cursor-pointer border-2 border-dashed border-gray-600 hover:border-blue-500"
            phx-click="show_create_modal"
          >
            <div class="text-center">
              <.icon
                name="hero-plus"
                class="w-8 h-8 lg:w-12 lg:h-12 text-gray-400 mx-auto mb-3 lg:mb-4"
              />
              <h4 class="text-white text-lg lg:text-xl font-semibold mb-2 lg:mb-3">
                Criar Nova Lista
              </h4>
              <p class="text-gray-400 text-sm lg:text-base">
                Crie uma nova lista personalizada para organizar seus filmes e séries
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <.bottom_navigation current_page={@current_page} />
</div>

<!-- Create List Modal -->
<%= if @show_modal do %>
  <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-[#1a1a1a] rounded-lg p-6 max-w-md w-full mx-4">
      <!-- Modal Header -->
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-white text-lg font-bold">Criar Nova Lista</h3>
        <button phx-click="close_modal" class="text-gray-400 hover:text-white transition-colors">
          <.icon name="hero-x-mark" class="w-6 h-6" />
        </button>
      </div>
      
<!-- Form -->
      <.form for={%{}} phx-submit="create_list" phx-change="validate_list" class="space-y-4">
        <div>
          <label class="block text-white text-sm font-medium mb-2">
            Nome da Lista
          </label>
          <input
            type="text"
            name="name"
            value={@list_form["name"]}
            placeholder="Digite o nome da lista"
            class="w-full px-3 py-2 bg-[#303030] text-white border border-[#474747] rounded-lg focus:outline-none focus:border-blue-500 transition-colors"
            required
          />
        </div>

        <div>
          <label class="block text-white text-sm font-medium mb-2">
            Descrição
          </label>
          <textarea
            name="description"
            value={@list_form["description"]}
            placeholder="Digite uma descrição para a lista (opcional)"
            rows="3"
            class="w-full px-3 py-2 bg-[#303030] text-white border border-[#474747] rounded-lg focus:outline-none focus:border-blue-500 transition-colors resize-none"
          ></textarea>
        </div>
        
<!-- Modal Actions -->
        <div class="flex gap-3 pt-4">
          <button
            type="button"
            phx-click="close_modal"
            class="flex-1 px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors"
          >
            Cancelar
          </button>
          <button
            type="submit"
            class="flex-1 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
          >
            Criar Lista
          </button>
        </div>
      </.form>
    </div>
  </div>
<% end %>

<!-- Edit List Modal -->
<%= if @show_edit_modal do %>
  <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-[#1a1a1a] rounded-lg p-6 max-w-md w-full mx-4">
      <!-- Modal Header -->
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-white text-lg font-bold">Editar Lista</h3>
        <button
          phx-click="close_edit_modal"
          class="text-gray-400 hover:text-white transition-colors"
        >
          <.icon name="hero-x-mark" class="w-6 h-6" />
        </button>
      </div>
      
<!-- Form -->
      <.form for={%{}} phx-submit="update_list" phx-change="validate_edit_list" class="space-y-4">
        <div>
          <label class="block text-white text-sm font-medium mb-2">
            Nome da Lista
          </label>
          <input
            type="text"
            name="name"
            value={@edit_form["name"]}
            placeholder="Digite o nome da lista"
            class="w-full px-3 py-2 bg-[#303030] text-white border border-[#474747] rounded-lg focus:outline-none focus:border-blue-500 transition-colors"
            required
          />
        </div>

        <div>
          <label class="block text-white text-sm font-medium mb-2">
            Descrição
          </label>
          <textarea
            name="description"
            value={@edit_form["description"]}
            placeholder="Digite uma descrição para a lista (opcional)"
            rows="3"
            class="w-full px-3 py-2 bg-[#303030] text-white border border-[#474747] rounded-lg focus:outline-none focus:border-blue-500 transition-colors resize-none"
          ></textarea>
        </div>
        
<!-- Modal Actions -->
        <div class="flex gap-3 pt-4">
          <button
            type="button"
            phx-click="close_edit_modal"
            class="flex-1 px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors"
          >
            Cancelar
          </button>
          <button
            type="submit"
            class="flex-1 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
          >
            Salvar Alterações
          </button>
        </div>
      </.form>
    </div>
  </div>
<% end %>
