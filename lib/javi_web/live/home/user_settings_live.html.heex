<div
  class="relative flex size-full min-h-screen flex-col bg-[#141414] dark justify-between group/design-root overflow-x-hidden lg:ml-64"
  style='font-family: "Plus Jakarta Sans", "Noto Sans", sans-serif;'
>
  <!-- Header -->
  <.top_header show_back title="Configurações da Conta" />

  <div class="flex-1 overflow-y-auto pb-24 pt-20">
    <div class="px-4 lg:px-8 py-6 lg:py-8 max-w-7xl mx-auto">
      <div class="space-y-8 lg:space-y-12">
        
<!-- Account Overview Section -->
        <div class="bg-[#212121] rounded-lg p-6 lg:p-8">
          <h3 class="text-white text-lg lg:text-xl font-semibold mb-4 lg:mb-6">
            Visão Geral da Conta
          </h3>
          <p class="text-gray-400 text-sm lg:text-base mb-6 lg:mb-8">
            Informações básicas da sua conta
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
            <div class="bg-[#303030] rounded-lg p-4 lg:p-6">
              <div class="flex items-center gap-3 mb-3 lg:mb-4">
                <div class="w-10 h-10 lg:w-12 lg:h-12 bg-blue-600 rounded-full flex items-center justify-center">
                  <.icon name="hero-user" class="w-5 h-5 lg:w-6 lg:h-6 text-white" />
                </div>
                <div>
                  <p class="text-gray-400 text-sm lg:text-base">Nome de Exibição</p>
                  <p class="text-white font-semibold text-sm lg:text-base">
                    {@current_user.display_name || "Não definido"}
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-[#303030] rounded-lg p-4 lg:p-6">
              <div class="flex items-center gap-3 mb-3 lg:mb-4">
                <div class="w-10 h-10 lg:w-12 lg:h-12 bg-green-600 rounded-full flex items-center justify-center">
                  <.icon name="hero-envelope" class="w-5 h-5 lg:w-6 lg:h-6 text-white" />
                </div>
                <div>
                  <p class="text-gray-400 text-sm lg:text-base">Email</p>
                  <p class="text-white font-semibold text-sm lg:text-base">
                    {@current_user.email}
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-[#303030] rounded-lg p-4 lg:p-6">
              <div class="flex items-center gap-3 mb-3 lg:mb-4">
                <div class="w-10 h-10 lg:w-12 lg:h-12 bg-purple-600 rounded-full flex items-center justify-center">
                  <.icon name="hero-shield-check" class="w-5 h-5 lg:w-6 lg:h-6 text-white" />
                </div>
                <div>
                  <p class="text-gray-400 text-sm lg:text-base">Status da Conta</p>
                  <p class="text-white font-semibold text-sm lg:text-base">Ativo</p>
                </div>
              </div>
            </div>

            <div class="bg-[#303030] rounded-lg p-4 lg:p-6">
              <div class="flex items-center gap-3 mb-3 lg:mb-4">
                <div class="w-10 h-10 lg:w-12 lg:h-12 bg-orange-600 rounded-full flex items-center justify-center">
                  <.icon name="hero-calendar" class="w-5 h-5 lg:w-6 lg:h-6 text-white" />
                </div>
                <div>
                  <p class="text-gray-400 text-sm lg:text-base">Membro Desde</p>
                  <p class="text-white font-semibold text-sm lg:text-base">
                    {Date.to_string(@current_user.inserted_at)}
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
        
<!-- Profile Information Form -->
        <div class="bg-[#212121] rounded-lg p-6 lg:p-8">
          <h3 class="text-white text-lg lg:text-xl font-semibold mb-4 lg:mb-6">
            Informações do Perfil
          </h3>
          <p class="text-gray-400 text-sm lg:text-base mb-6 lg:mb-8">
            Atualize suas informações pessoais
          </p>

          <.form
            for={@profile_form}
            phx-submit="update_profile"
            phx-change="validate_profile"
            class="space-y-6 lg:space-y-8"
          >
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
              <div class="space-y-2 lg:space-y-3">
                <label class="block text-sm lg:text-base font-medium text-gray-300">
                  Nome de Exibição
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3 lg:pl-4 flex items-center pointer-events-none">
                    <.icon name="hero-user" class="h-5 w-5 lg:h-6 lg:w-6 text-gray-400" />
                  </div>
                  <PetalComponents.Form.text_input
                    form={@profile_form}
                    field={:display_name}
                    class="form-input block w-full pl-10 lg:pl-12 pr-3 py-3 lg:py-4 border border-gray-600 rounded-xl bg-[#303030] text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 text-base lg:text-lg"
                    placeholder="Digite seu nome de exibição"
                  />
                </div>
                <%= if @profile_form[:display_name].errors do %>
                  <div class="text-red-400 text-sm lg:text-base mt-1">
                    <%= for error <- @profile_form[:display_name].errors do %>
                      <p>{elem(error, 0)}</p>
                    <% end %>
                  </div>
                <% end %>
              </div>
              
<!-- Nickname -->
              <div class="space-y-2 lg:space-y-3">
                <label class="block text-sm lg:text-base font-medium text-gray-300">
                  Apelido (nickname)
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3 lg:pl-4 flex items-center pointer-events-none">
                    <.icon name="hero-at-symbol" class="h-5 w-5 lg:h-6 lg:w-6 text-gray-400" />
                  </div>
                  <PetalComponents.Form.text_input
                    form={@profile_form}
                    field={:nickname}
                    class="form-input block w-full pl-10 lg:pl-12 pr-24 py-3 lg:py-4 border border-gray-600 rounded-xl bg-[#303030] text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 text-base lg:text-lg"
                    placeholder="seu-nick"
                  />
                  <div class="absolute inset-y-0 right-0 pr-4 flex items-center">
                    <span class={
                      "text-xs font-medium px-2 py-1 rounded " <>
                      (if to_string(@profile_form[:nickname].value || "") != "" do
                         if @nickname_available, do: "text-green-300 bg-green-900/40", else: "text-red-300 bg-red-900/40"
                       else
                         "hidden"
                       end)
                    }>
                      {if @nickname_available, do: "Disponível", else: "Indisponível"}
                    </span>
                  </div>
                </div>
                <%= if @profile_form[:nickname].errors do %>
                  <div class="text-red-400 text-sm lg:text-base mt-1">
                    <%= for error <- @profile_form[:nickname].errors do %>
                      <p>{elem(error, 0)}</p>
                    <% end %>
                  </div>
                <% end %>
              </div>
              
<!-- Email -->
              <div class="space-y-2 lg:space-y-3">
                <label class="block text-sm lg:text-base font-medium text-gray-300">
                  Email
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3 lg:pl-4 flex items-center pointer-events-none">
                    <.icon name="hero-envelope" class="h-5 w-5 lg:h-6 lg:w-6 text-gray-400" />
                  </div>
                  <PetalComponents.Form.email_input
                    form={@profile_form}
                    field={:email}
                    class="form-input block w-full pl-10 lg:pl-12 pr-3 py-3 lg:py-4 border border-gray-600 rounded-xl bg-[#303030] text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 text-base lg:text-lg"
                    placeholder="seu@email.com"
                  />
                </div>
                <%= if @profile_form[:email].errors do %>
                  <div class="text-red-400 text-sm lg:text-base mt-1">
                    <%= for error <- @profile_form[:email].errors do %>
                      <p>{elem(error, 0)}</p>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>

            <div class="flex justify-end">
              <button
                type="submit"
                class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 lg:py-4 px-6 lg:px-8 rounded-xl transition-all duration-200 transform hover:scale-105 shadow-lg text-base lg:text-lg"
                phx-disable-with="Salvando..."
              >
                <span class="flex items-center justify-center">
                  <.icon name="hero-check" class="w-5 h-5 lg:w-6 lg:h-6 mr-2" /> Salvar Alterações
                </span>
              </button>
            </div>
          </.form>
        </div>
        
<!-- Change Password Form -->
        <div class="bg-[#212121] rounded-lg p-6 lg:p-8">
          <h3 class="text-white text-lg lg:text-xl font-semibold mb-4 lg:mb-6">
            Alterar Senha
          </h3>
          <p class="text-gray-400 text-sm lg:text-base mb-6 lg:mb-8">
            Atualize sua senha para manter a conta segura
          </p>

          <.form
            for={@password_form}
            phx-submit="update_password"
            phx-change="validate_password"
            class="space-y-6 lg:space-y-8"
          >
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
              <div class="space-y-2 lg:space-y-3">
                <label class="block text-sm lg:text-base font-medium text-gray-300">
                  Senha Atual
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3 lg:pl-4 flex items-center pointer-events-none">
                    <.icon name="hero-key" class="h-5 w-5 lg:h-6 lg:w-6 text-gray-400" />
                  </div>
                  <PetalComponents.Form.password_input
                    form={@password_form}
                    field={:current_password}
                    class="form-input block w-full pl-10 lg:pl-12 pr-3 py-3 lg:py-4 border border-gray-600 rounded-xl bg-[#303030] text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 text-base lg:text-lg"
                    placeholder="Digite sua senha atual"
                  />
                </div>
                <%= if @password_form[:current_password].errors do %>
                  <div class="text-red-400 text-sm lg:text-base mt-1">
                    <%= for error <- @password_form[:current_password].errors do %>
                      <p>{elem(error, 0)}</p>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <div class="space-y-2 lg:space-y-3">
                <label class="block text-sm lg:text-base font-medium text-gray-300">
                  Nova Senha
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3 lg:pl-4 flex items-center pointer-events-none">
                    <.icon name="hero-lock-closed" class="h-5 w-5 lg:h-6 lg:w-6 text-gray-400" />
                  </div>
                  <PetalComponents.Form.password_input
                    form={@password_form}
                    field={:password}
                    class="form-input block w-full pl-10 lg:pl-12 pr-3 py-3 lg:py-4 border border-gray-600 rounded-xl bg-[#303030] text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 text-base lg:text-lg"
                    placeholder="Digite a nova senha"
                  />
                </div>
                <%= if @password_form[:password].errors do %>
                  <div class="text-red-400 text-sm lg:text-base mt-1">
                    <%= for error <- @password_form[:password].errors do %>
                      <p>{elem(error, 0)}</p>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>

            <div class="space-y-2 lg:space-y-3">
              <label class="block text-sm lg:text-base font-medium text-gray-300">
                Confirmar Nova Senha
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 lg:pl-4 flex items-center pointer-events-none">
                  <.icon name="hero-lock-closed" class="h-5 w-5 lg:h-6 lg:w-6 text-gray-400" />
                </div>
                <PetalComponents.Form.password_input
                  form={@password_form}
                  field={:password_confirmation}
                  class="form-input block w-full pl-10 lg:pl-12 pr-3 py-3 lg:py-4 border border-gray-600 rounded-xl bg-[#303030] text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 text-base lg:text-lg"
                  placeholder="Confirme a nova senha"
                />
              </div>
              <%= if @password_form[:password_confirmation].errors do %>
                <div class="text-red-400 text-sm lg:text-base mt-1">
                  <%= for error <- @password_form[:password_confirmation].errors do %>
                    <p>{elem(error, 0)}</p>
                  <% end %>
                </div>
              <% end %>
            </div>

            <div class="flex justify-end">
              <button
                type="submit"
                class="bg-green-600 hover:bg-green-700 text-white font-semibold py-3 lg:py-4 px-6 lg:px-8 rounded-xl transition-all duration-200 transform hover:scale-105 shadow-lg text-base lg:text-lg"
                phx-disable-with="Alterando..."
              >
                <span class="flex items-center justify-center">
                  <.icon name="hero-key" class="w-5 h-5 lg:w-6 lg:h-6 mr-2" /> Alterar Senha
                </span>
              </button>
            </div>
          </.form>
        </div>
        
<!-- Quick Actions Section -->
        <div class="bg-[#212121] rounded-lg p-6 lg:p-8">
          <h3 class="text-white text-lg lg:text-xl font-semibold mb-4 lg:mb-6">Ações Rápidas</h3>
          <p class="text-gray-400 text-sm lg:text-base mb-6 lg:mb-8">
            Acesse rapidamente as principais funcionalidades
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6">
            <button
              phx-click="navigate_to_search"
              class="bg-[#303030] hover:bg-[#404040] rounded-lg p-4 lg:p-6 text-left transition-colors"
            >
              <div class="flex items-center gap-3 mb-2 lg:mb-3">
                <.icon name="hero-magnifying-glass" class="w-6 h-6 lg:w-8 lg:h-8 text-blue-400" />
                <h4 class="text-white text-base lg:text-lg font-semibold">Pesquisar</h4>
              </div>
              <p class="text-gray-400 text-sm lg:text-base">Encontre filmes e séries</p>
            </button>

            <button
              phx-click="navigate_to_lists"
              class="bg-[#303030] hover:bg-[#404040] rounded-lg p-4 lg:p-6 text-left transition-colors"
            >
              <div class="flex items-center gap-3 mb-2 lg:mb-3">
                <.icon name="hero-list-bullet" class="w-6 h-6 lg:w-8 lg:h-8 text-purple-400" />
                <h4 class="text-white text-base lg:text-lg font-semibold">Minhas Listas</h4>
              </div>
              <p class="text-gray-400 text-sm lg:text-base">Gerencie suas listas</p>
            </button>

            <button
              phx-click="navigate_to_profile"
              class="bg-[#303030] hover:bg-[#404040] rounded-lg p-4 lg:p-6 text-left transition-colors"
            >
              <div class="flex items-center gap-3 mb-2 lg:mb-3">
                <.icon name="hero-user" class="w-6 h-6 lg:w-8 lg:h-8 text-green-400" />
                <h4 class="text-white text-base lg:text-lg font-semibold">Perfil</h4>
              </div>
              <p class="text-gray-400 text-sm lg:text-base">Veja suas estatísticas</p>
            </button>
          </div>
        </div>
        
<!-- Account Security Section -->
        <div class="bg-[#212121] rounded-lg p-6 lg:p-8">
          <h3 class="text-white text-lg lg:text-xl font-semibold mb-4 lg:mb-6">
            Segurança da Conta
          </h3>
          <p class="text-gray-400 text-sm lg:text-base mb-6 lg:mb-8">
            Gerencie a segurança da sua conta
          </p>

          <div class="space-y-4 lg:space-y-6">
            <div class="bg-[#303030] rounded-lg p-4 lg:p-6">
              <div class="flex items-center justify-between">
                <div>
                  <h4 class="text-white text-base lg:text-lg font-semibold mb-1 lg:mb-2">
                    Exportar Dados
                  </h4>
                  <p class="text-gray-400 text-sm lg:text-base">Baixe todos os seus dados</p>
                </div>
                <button
                  phx-click="export_data"
                  class="bg-blue-600 hover:bg-blue-700 text-white px-4 lg:px-6 py-2 lg:py-3 rounded-lg text-sm lg:text-base font-medium transition-colors"
                >
                  Exportar
                </button>
              </div>
            </div>

            <div class="bg-[#303030] rounded-lg p-4 lg:p-6">
              <div class="flex items-center justify-between">
                <div>
                  <h4 class="text-white text-base lg:text-lg font-semibold mb-1 lg:mb-2">
                    Deletar Conta
                  </h4>
                  <p class="text-gray-400 text-sm lg:text-base">
                    Excluir permanentemente sua conta
                  </p>
                </div>
                <button
                  phx-click="delete_account"
                  class="bg-red-600 hover:bg-red-700 text-white px-4 lg:px-6 py-2 lg:py-3 rounded-lg text-sm lg:text-base font-medium transition-colors"
                >
                  Deletar
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
<!-- Bottom Navigation -->
  <div class="fixed bottom-0 left-0 right-0 z-50 bg-[#212121]">
    <div class="flex gap-2 border-t border-[#303030] bg-[#212121] px-4 pb-3 pt-2">
      <.link
        navigate={~p"/inicio"}
        class={"just flex flex-1 flex-col items-center justify-end gap-1 #{if @current_page == :home, do: "text-white", else: "text-[#ababab]"}"}
      >
        <div class={"#{if @current_page == :home, do: "text-white", else: "text-[#ababab]"} flex h-8 items-center justify-center"}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24px"
            height="24px"
            fill="currentColor"
            viewBox="0 0 256 256"
          >
            <path d="M224,115.55V208a16,16,0,0,1-16,16H168a16,16,0,0,1-16-16V168a8,8,0,0,0-8-8H112a8,8,0,0,0-8,8v40a16,16,0,0,1-16,16H48a16,16,0,0,1-16-16V115.55a16,16,0,0,1,5.17-11.78l80-75.48.11-.11a16,16,0,0,1,21.53,0,1.14,1.14,0,0,0,.11.11l80,75.48A16,16,0,0,1,224,115.55Z">
            </path>
          </svg>
        </div>
        <p class={"#{if @current_page == :home, do: "text-white", else: "text-[#ababab]"} text-xs font-medium leading-normal tracking-[0.015em]"}>
          Início
        </p>
      </.link>

      <.link
        navigate={~p"/pesquisar"}
        class={"just flex flex-1 flex-col items-center justify-end gap-1 #{if @current_page == :search, do: "text-white", else: "text-[#ababab]"}"}
      >
        <div class={"#{if @current_page == :search, do: "text-white", else: "text-[#ababab]"} flex h-8 items-center justify-center"}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24px"
            height="24px"
            fill="currentColor"
            viewBox="0 0 256 256"
          >
            <path d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z">
            </path>
          </svg>
        </div>
        <p class={"#{if @current_page == :search, do: "text-white", else: "text-[#ababab]"} text-xs font-medium leading-normal tracking-[0.015em]"}>
          Pesquisar
        </p>
      </.link>

      <.link
        navigate={~p"/listas"}
        class={"just flex flex-1 flex-col items-center justify-end gap-1 #{if @current_page == :media, do: "text-white", else: "text-[#ababab]"}"}
      >
        <div class={"#{if @current_page == :media, do: "text-white", else: "text-[#ababab]"} flex h-8 items-center justify-center"}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24px"
            height="24px"
            fill="currentColor"
            viewBox="0 0 256 256"
          >
            <path d="M216,104H102.09L210,75.51a8,8,0,0,0,5.68-9.84l-8.16-30a15.93,15.93,0,0,0-19.42-11.13L35.81,64.74a15.75,15.75,0,0,0-9.7,7.4,15.51,15.51,0,0,0-1.55,12L32,111.56c0,.14,0,.29,0,.44v88a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V112A8,8,0,0,0,216,104ZM192.16,40l6,22.07-22.62,6L147.42,51.83Zm-66.69,17.6,28.12,16.24-36.94,9.75L88.53,67.37Zm-79.4,44.62-6-22.08,26.5-7L94.69,89.4ZM208,200H48V120H208v80Z">
            </path>
          </svg>
        </div>
        <p class={"#{if @current_page == :media, do: "text-white", else: "text-[#ababab]"} text-xs font-medium leading-normal tracking-[0.015em]"}>
          Listas
        </p>
      </.link>

      <.link
        navigate={~p"/perfil"}
        class={"just flex flex-1 flex-col items-center justify-end gap-1 #{if @current_page == :profile, do: "text-white", else: "text-[#ababab]"}"}
      >
        <div class={"#{if @current_page == :profile, do: "text-white", else: "text-[#ababab]"} flex h-8 items-center justify-center"}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24px"
            height="24px"
            fill="currentColor"
            viewBox="0 0 256 256"
          >
            <path d="M230.92,212c-15.23-26.33-38.7-45.21-66.09-54.16a72,72,0,1,0-73.66,0C63.78,166.78,40.31,185.66,25.08,212a8,8,0,1,0,13.85,8c18.84-32.56,52.14-52,89.07-52s70.23,19.44,89.07,52a8,8,0,1,0,13.85-8ZM72,96a56,56,0,1,1,56,56A56.06,56.06,0,0,1,72,96Z">
            </path>
          </svg>
        </div>
        <p class={"#{if @current_page == :profile, do: "text-white", else: "text-[#ababab]"} text-xs font-medium leading-normal tracking-[0.015em]"}>
          Perfil
        </p>
      </.link>
    </div>
    <div class="h-5 bg-[#212121]"></div>
  </div>
</div>
