<div
  class="relative flex size-full min-h-screen flex-col bg-[#141414] dark justify-between group/design-root overflow-x-hidden lg:ml-64"
  style='font-family: "Plus Jakarta Sans", "Noto Sans", sans-serif;'
>
  <!-- Header -->
  <div class="fixed top-0 left-0 right-0 z-50 flex items-center bg-[#141414] p-4 pb-2 justify-between lg:ml-64 border-b border-[#303030]">
    <button
      class="text-white flex size-12 shrink-0 items-center"
      phx-click="go_back"
      data-icon="ArrowLeft"
      data-size="24px"
      data-weight="regular"
    >
      <.icon name="hero-arrow-left" class="w-6 h-6" />
    </button>
    <h2 class="text-white text-lg lg:text-xl font-bold leading-tight tracking-[-0.015em] flex-1 text-center">
      {if @list, do: @list.name, else: "Lista"}
    </h2>
    <div class="w-12"></div>
  </div>

  <div class="flex-1 overflow-y-auto pb-24 pt-20">
    <%= if @show_search do %>
      <div class="px-4 py-3 bg-[#1a1a1a] border-b border-[#333333]">
        <.form for={%{}} phx-submit="search" class="flex flex-col min-w-40 h-12 w-full">
          <div class="flex w-full flex-1 items-stretch rounded-xl h-full">
            <div
              class="text-[#ababab] flex border-none bg-[#303030] items-center justify-center pl-4 rounded-l-xl border-r-0"
              data-icon="MagnifyingGlass"
              data-size="24px"
              data-weight="regular"
            >
              <.icon name="hero-magnifying-glass" class="w-6 h-6" />
            </div>
            <input
              name="query"
              placeholder="Pesquisar filmes e séries..."
              class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-none text-white focus:outline-0 focus:ring-0 border-none bg-[#303030] focus:border-none h-full placeholder:text-[#ababab] px-4 border-l-0 border-r-0 pl-2 text-base font-normal leading-normal"
              value={@query}
              phx-keyup="search"
              phx-throttle="300"
            />
            <button
              type="button"
              phx-click="toggle_search"
              class="text-[#ababab] flex border-none bg-[#303030] items-center justify-center px-4 rounded-r-xl border-l-0 hover:text-white transition-colors"
            >
              <.icon name="hero-x-mark" class="w-5 h-5" />
            </button>
          </div>
        </.form>
      </div>

      <%= if @search_results != [] do %>
        <div class="px-4 py-4 bg-[#1a1a1a] border-b border-[#333333]">
          <h3 class="text-white text-lg font-bold leading-tight tracking-[-0.015em] mb-3">
            Resultados da Pesquisa
          </h3>
          <div class="overflow-x-auto [-ms-scrollbar-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
            <div class="flex gap-3 pb-2" style="min-width: max-content;">
              <%= for movie <- @search_results do %>
                <div class="flex flex-col gap-2 min-w-[120px] w-[120px]">
                  <div class="relative group">
                    <div
                      class="w-full bg-center bg-no-repeat aspect-[2/3] bg-cover rounded-xl cursor-pointer hover:opacity-90 transition-opacity"
                      style={"background-image: url(#{movie["poster_path"] && "https://image.tmdb.org/t/p/w500#{movie["poster_path"]}"})"}
                      phx-click="navigate_to_title"
                      phx-value-title={Jason.encode!(movie)}
                    >
                    </div>
                    <div class="absolute top-2 right-2">
                      <button
                        phx-click="add_to_list"
                        phx-value-title={Jason.encode!(movie)}
                        class="bg-white text-gray-800 p-2 rounded-full shadow-lg opacity-30 hover:opacity-100 transition-all duration-200"
                        title="Adicionar à Lista"
                      >
                        <.icon name="hero-plus" class="w-4 h-4" />
                      </button>
                    </div>
                  </div>
                  <div>
                    <p class="text-[#ababab] text-sm font-medium leading-normal truncate">
                      {movie["title"] || movie["name"]}
                    </p>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>

    <%= if @list do %>
      <div class="px-4 py-6">
        <%= if length(@list_items) > 0 do %>
          <div class="grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5">
            <!-- Add Card -->
            <div class="flex flex-col gap-2">
              <div
                class="w-full bg-center bg-no-repeat aspect-[3/4] bg-cover rounded-xl flex flex-col relative cursor-pointer hover:opacity-90 transition-opacity border-2 border-dashed border-[#474747] hover:border-[#666666]"
                phx-click="toggle_search"
              >
                <div class="absolute inset-0 bg-black bg-opacity-20 rounded-xl"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="text-center">
                    <.icon name="hero-plus" class="text-[#ababab] mx-auto mb-2 w-12 h-12" />
                    <p class="text-[#ababab] text-sm font-medium leading-normal">
                      Adicionar
                    </p>
                  </div>
                </div>
              </div>
            </div>
            
<!-- List Items -->
            <%= for item <- @list_items do %>
              <div class="flex flex-col gap-2">
                <div
                  class="w-full bg-center bg-no-repeat aspect-[3/4] bg-cover rounded-xl flex flex-col cursor-pointer hover:opacity-90 transition-opacity relative"
                  style={"background-image: url(\"https://image.tmdb.org/t/p/w500#{item.title.poster_path}\");"}
                  phx-click="navigate_to_title"
                  phx-value-title-id={item.title.id}
                >
                  <!-- Remove button positioned at bottom right inside the poster -->
                  <div class="absolute bottom-2 right-2">
                    <button
                      phx-click="remove_from_list"
                      phx-value-list-item-id={item.id}
                      class="bg-red-600 text-white p-2 rounded-full shadow-lg opacity-80 hover:opacity-100 transition-all duration-200 hover:bg-red-700"
                      title="Remover da Lista"
                    >
                      <.icon name="hero-x-mark" class="w-4 h-4" />
                    </button>
                  </div>
                </div>
                <div>
                  <p class="text-[#ababab] text-sm font-medium leading-normal truncate">
                    {item.title.title}
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5">
            <!-- Add Card -->
            <div class="flex flex-col gap-2">
              <div
                class="w-full bg-center bg-no-repeat aspect-[3/4] bg-cover rounded-xl flex flex-col relative cursor-pointer hover:opacity-90 transition-opacity border-2 border-dashed border-[#474747] hover:border-[#666666]"
                phx-click="toggle_search"
              >
                <div class="absolute inset-0 bg-black bg-opacity-20 rounded-xl"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="text-center">
                    <.icon name="hero-plus" class="text-[#ababab] mx-auto mb-2 w-12 h-12" />
                    <p class="text-[#ababab] text-sm font-medium leading-normal">
                      Adicionar
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="flex flex-col items-center justify-center p-8">
            <div class="text-center">
              <p class="text-[#ababab] text-base font-medium leading-normal mb-2">
                Esta lista está vazia
              </p>
              <p class="text-[#ababab] text-sm font-normal leading-normal">
                Clique no card acima para adicionar filmes e séries
              </p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="flex flex-col items-center justify-center p-8">
        <div class="text-center">
          <p class="text-[#ababab] text-base font-medium leading-normal mb-2">
            Lista não encontrada
          </p>
          <p class="text-[#ababab] text-sm font-normal leading-normal">
            A lista que você está procurando não existe ou foi removida
          </p>
        </div>
      </div>
    <% end %>
  </div>

  <.bottom_navigation current_page={@current_page} />
</div>
