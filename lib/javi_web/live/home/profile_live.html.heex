<div
  class="relative flex size-full min-h-screen flex-col bg-[#141414] dark justify-between group/design-root overflow-x-hidden lg:ml-64"
  style='font-family: "Plus Jakarta Sans", "Noto Sans", sans-serif;'
>
  <!-- Header -->
  <div class="fixed top-0 left-0 right-0 z-50 flex items-center bg-[#141414] p-4 pb-2 justify-between lg:ml-64 border-b border-[#303030]">
    <div class="w-12"></div>
    <h2 class="text-white text-lg lg:text-xl font-bold leading-tight tracking-[-0.015em] flex-1 text-center">
      Perfil
    </h2>
    
<!-- User Dropdown Menu -->
    <div class="relative">
      <button
        id="user-dropdown-button"
        class="flex items-center gap-2 px-4 lg:px-6 py-2 lg:py-3 bg-[#303030] text-white rounded-lg text-sm lg:text-base font-medium hover:bg-[#404040] transition-colors"
      >
        <span>Menu</span>
        <.icon name="hero-chevron-down" class="w-4 h-4" />
      </button>
      
<!-- Dropdown Menu -->
      <div
        id="user-dropdown-menu"
        class="hidden absolute right-0 top-full mt-2 w-48 bg-[#212121] rounded-lg shadow-lg border border-[#303030] z-50"
      >
        <div class="py-2">
          <.link
            navigate={~p"/configuracoes"}
            class="flex items-center gap-3 px-4 py-3 text-gray-300 hover:text-white hover:bg-[#303030] transition-colors"
          >
            <.icon name="hero-user" class="w-4 h-4" />
            <span>Editar Perfil</span>
          </.link>

          <.link
            href="/terms"
            class="flex items-center gap-3 px-4 py-3 text-gray-300 hover:text-white hover:bg-[#303030] transition-colors"
          >
            <.icon name="hero-document-text" class="w-4 h-4" />
            <span>Termos da Plataforma</span>
          </.link>

          <div class="border-t border-[#303030] my-2"></div>

          <button
            phx-click="logout"
            class="flex items-center gap-3 px-4 py-3 text-red-400 hover:text-red-300 hover:bg-[#303030] transition-colors w-full text-left"
          >
            <.icon name="hero-arrow-right-on-rectangle" class="w-4 h-4" />
            <span>Sair</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="flex-1 overflow-y-auto pb-24 pt-20">
    <div class="px-4 lg:px-8 py-6 lg:py-8 max-w-7xl mx-auto">
      
<!-- User Info -->
      <div class="flex items-center gap-4 lg:gap-6 mb-6 lg:mb-8">
        <div class="w-20 h-20 lg:w-24 lg:h-24 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center">
          <span class="text-white text-2xl lg:text-3xl font-bold">
            {if @user.display_name || @user.email,
              do: String.first(@user.display_name || @user.email),
              else: "U"}
          </span>
        </div>
        <div class="flex-1">
          <h1 class="text-white text-2xl lg:text-3xl font-bold mb-1 lg:mb-2">
            {@user.display_name || "Usuário"}
          </h1>
          <p class="text-gray-400 text-sm lg:text-base">{@user.email}</p>
        </div>
        <.link
          navigate={~p"/configuracoes"}
          class="px-4 lg:px-6 py-2 lg:py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-sm lg:text-base"
        >
          Editar Perfil
        </.link>
      </div>
      
<!-- Statistics Section -->
      <div class="bg-[#212121] rounded-lg p-6 lg:p-8 mb-8 lg:mb-12">
        <h3 class="text-white text-lg lg:text-xl font-semibold mb-4 lg:mb-6">Estatísticas</h3>
        <p class="text-gray-400 text-sm lg:text-base mb-6 lg:mb-8">Suas estatísticas de uso</p>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6 mb-6 lg:mb-8">
          <div class="bg-[#303030] rounded-lg p-4 lg:p-6">
            <p class="text-gray-400 text-sm lg:text-base mb-1 lg:mb-2">Total Assistido</p>
            <p class="text-white text-2xl lg:text-3xl font-bold">{@user_stats.total_watched}</p>
          </div>
          <div class="bg-[#303030] rounded-lg p-4 lg:p-6">
            <p class="text-gray-400 text-sm lg:text-base mb-1 lg:mb-2">Tempo Gasto</p>
            <p class="text-white text-2xl lg:text-3xl font-bold">{@user_stats.time_spent}</p>
          </div>
          <div class="bg-[#303030] rounded-lg p-4 lg:p-6">
            <p class="text-gray-400 text-sm lg:text-base mb-1 lg:mb-2">Avaliação Média</p>
            <p class="text-white text-2xl lg:text-3xl font-bold">
              {if @user_stats.average_rating,
                do: Decimal.round(@user_stats.average_rating, 1),
                else: "0.0"}
            </p>
          </div>
          <div class="bg-[#303030] rounded-lg p-4 lg:p-6">
            <p class="text-gray-400 text-sm lg:text-base mb-1 lg:mb-2">Avaliações Dadas</p>
            <p class="text-white text-2xl lg:text-3xl font-bold">{@user_stats.total_ratings}</p>
          </div>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
          <div class="bg-[#303030] rounded-lg p-4 lg:p-6">
            <p class="text-gray-400 text-sm lg:text-base mb-1 lg:mb-2">Assistindo</p>
            <p class="text-white text-xl lg:text-2xl font-bold">{@user_stats.total_watching}</p>
          </div>
          <div class="bg-[#303030] rounded-lg p-4 lg:p-6">
            <p class="text-gray-400 text-sm lg:text-base mb-1 lg:mb-2">Favoritos</p>
            <p class="text-white text-xl lg:text-2xl font-bold">{@user_stats.total_favorites}</p>
          </div>
        </div>
      </div>
      
<!-- Recent Activity Section -->
      <div class="bg-[#212121] rounded-lg p-6 lg:p-8 mb-8 lg:mb-12">
        <h3 class="text-white text-lg lg:text-xl font-semibold mb-4 lg:mb-6">
          Atividades Recentes
        </h3>
        <p class="text-gray-400 text-sm lg:text-base mb-6 lg:mb-8">
          Suas atividades mais recentes
        </p>

        <%= if length(@recent_watched) > 0 do %>
          <div class="space-y-4 lg:space-y-6">
            <%= for item <- @recent_watched do %>
              <div class="flex items-center gap-4 lg:gap-6 p-4 lg:p-6 bg-[#303030] rounded-lg">
                <div class="w-16 h-24 lg:w-20 lg:h-28 bg-gray-600 rounded-lg overflow-hidden flex-shrink-0">
                  <%= if item.poster_path do %>
                    <img
                      src={"https://image.tmdb.org/t/p/w200#{item.poster_path}"}
                      alt={item.title}
                      class="w-full h-full object-cover"
                    />
                  <% else %>
                    <div class="w-full h-full bg-gray-700 flex items-center justify-center">
                      <.icon name="hero-film" class="w-8 h-8 lg:w-10 lg:h-10 text-gray-400" />
                    </div>
                  <% end %>
                </div>
                <div class="flex-1 min-w-0">
                  <h4 class="text-white text-base lg:text-lg font-semibold mb-1 lg:mb-2 truncate">
                    {item.title}
                  </h4>
                  <div class="flex items-center gap-2 lg:gap-4 text-sm lg:text-base">
                    <span class="text-gray-400">
                      {if item.tmdb_type == "tv", do: "Série", else: "Filme"}
                    </span>
                    <span class="text-gray-400">•</span>
                    <span class="text-gray-400">
                      {if item.release_date && is_binary(item.release_date),
                        do: String.slice(item.release_date, 0, 4),
                        else: "N/A"}
                    </span>
                    <%= if item.rating do %>
                      <span class="text-gray-400">•</span>
                      <div class="flex items-center gap-1">
                        <.icon name="hero-star" class="w-4 h-4 text-yellow-400" />
                        <span class="text-gray-400">{item.rating}/5</span>
                      </div>
                    <% end %>
                  </div>
                  <p class="text-gray-500 text-xs lg:text-sm mt-1 lg:mt-2">
                    Assistido em {if item.date_watched,
                      do: Calendar.strftime(item.date_watched, "%d/%m/%Y"),
                      else: "Data desconhecida"}
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8 lg:py-12">
            <.icon
              name="hero-film"
              class="w-16 h-16 lg:w-20 lg:h-20 text-gray-400 mx-auto mb-4 lg:mb-6"
            />
            <h4 class="text-white text-lg lg:text-xl font-semibold mb-2 lg:mb-3">
              Nenhuma atividade recente
            </h4>
            <p class="text-gray-400 text-sm lg:text-base mb-4 lg:mb-6">
              Comece a assistir filmes e séries para ver suas atividades aqui
            </p>
            <button
              phx-click="navigate_to_search"
              class="bg-blue-600 hover:bg-blue-700 text-white px-6 lg:px-8 py-2 lg:py-3 rounded-lg font-medium transition-colors text-sm lg:text-base"
            >
              Explorar Filmes
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <.bottom_navigation current_page={@current_page} />
</div>

<script>
  // User dropdown menu functionality
  document.addEventListener('DOMContentLoaded', function() {
    const dropdownButton = document.getElementById('user-dropdown-button');
    const dropdownMenu = document.getElementById('user-dropdown-menu');
    
    if (dropdownButton && dropdownMenu) {
      // Toggle dropdown on button click
      dropdownButton.addEventListener('click', function(e) {
        e.stopPropagation();
        dropdownMenu.classList.toggle('hidden');
      });
      
      // Close dropdown when clicking outside
      document.addEventListener('click', function(event) {
        if (!dropdownButton.contains(event.target) && !dropdownMenu.contains(event.target)) {
          dropdownMenu.classList.add('hidden');
        }
      });
      
      // Close dropdown when clicking on menu items
      const menuItems = dropdownMenu.querySelectorAll('a, button');
      menuItems.forEach(item => {
        item.addEventListener('click', function() {
          dropdownMenu.classList.add('hidden');
        });
      });
    }
  });

  // Handle logout event from LiveView
  window.addEventListener('phx:logout', function() {
    // Create a form to submit the DELETE request
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/sair';
    
    // Add the CSRF token
    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
    const csrfInput = document.createElement('input');
    csrfInput.type = 'hidden';
    csrfInput.name = '_csrf_token';
    csrfInput.value = csrfToken;
    form.appendChild(csrfInput);
    
    // Add the _method field to make it a DELETE request
    const methodInput = document.createElement('input');
    methodInput.type = 'hidden';
    methodInput.name = '_method';
    methodInput.value = 'DELETE';
    form.appendChild(methodInput);
    
    // Submit the form
    document.body.appendChild(form);
    form.submit();
  });
</script>
