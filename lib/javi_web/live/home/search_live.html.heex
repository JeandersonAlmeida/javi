<div
  class="relative flex size-full min-h-screen flex-col bg-[#141414] dark justify-between group/design-root overflow-x-hidden lg:ml-64"
  style='font-family: "Plus Jakarta Sans", "Noto Sans", sans-serif;'
>
  <!-- Fixed Header with Search -->
  <.top_header show_back ml_for_sidebar={false} title="Pesquisar">
    <:bottom>
      <div class="px-4 lg:px-8 py-3 lg:py-4 max-w-4xl mx-auto">
        <.form for={%{}} phx-submit="search" class="flex flex-col min-w-40 h-12 lg:h-14 w-full">
          <div class="flex w-full flex-1 items-stretch rounded-xl h-full">
            <div
              class="text-[#ababab] flex border-none bg-[#303030] items-center justify-center pl-4 lg:pl-6 rounded-l-xl border-r-0"
              data-icon="MagnifyingGlass"
              data-size="24px"
              data-weight="regular"
            >
              <.icon name="hero-magnifying-glass" class="w-6 h-6" />
            </div>
            <input
              name="query"
              placeholder="Pesquisar filmes e séries..."
              class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-white focus:outline-0 focus:ring-0 border-none bg-[#303030] focus:border-none h-full placeholder:text-[#ababab] px-4 lg:px-6 rounded-l-none border-l-0 pl-2 text-base lg:text-lg font-normal leading-normal"
              value={@query}
              phx-keyup="search"
              phx-throttle="300"
            />
            <%= if @query != "" do %>
              <button
                type="button"
                phx-click="clear_search"
                class="text-[#ababab] flex border-none bg-[#303030] items-center justify-center px-4 lg:px-6 rounded-r-xl border-l-0 hover:text-white transition-colors"
              >
                <.icon name="hero-x-mark" class="w-5 h-5" />
              </button>
            <% end %>
          </div>
        </.form>
      </div>
    </:bottom>
  </.top_header>
  
<!-- Scrollable Content Area with Top Padding -->
  <div class="flex-1 overflow-y-auto pt-28 lg:pt-32 pb-24">
    <%= if @search_results != [] do %>
      <div class="max-w-7xl mx-auto px-4 lg:px-6">
        <h3 class="text-white text-lg lg:text-xl font-bold leading-tight tracking-[-0.015em] pb-4 lg:pb-6 pt-2 lg:pt-4">
          Resultados da Pesquisa
        </h3>
        <div class="grid grid-cols-3 gap-3 lg:gap-4 p-2 lg:p-4">
          <%= for title <- Enum.take(@search_results, 9) do %>
            <div class="flex flex-col gap-2 lg:gap-3">
              <div class="relative group">
                <div
                  class="w-full bg-center bg-no-repeat aspect-[2/3] bg-cover rounded-xl cursor-pointer hover:opacity-90 transition-opacity"
                  style={"background-image: url(#{title["poster_path"] && "https://image.tmdb.org/t/p/w500#{title["poster_path"]}"})"}
                  phx-click="navigate_to_title"
                  phx-value-title={Jason.encode!(title)}
                >
                </div>
                <div class="absolute top-2 right-2">
                  <button
                    phx-click="show_add_to_lists_modal"
                    phx-value-title={Jason.encode!(title)}
                    class="bg-white text-black w-8 h-8 rounded-full shadow-lg opacity-80 hover:opacity-100 transition-all duration-200 flex items-center justify-center"
                    title="Adicionar às Listas"
                  >
                    <.icon name="hero-plus" class="w-4 h-4" />
                  </button>
                </div>
                <!-- Rating Badge -->
                <%= if title["vote_average"] != nil and title["vote_average"] > 0 do %>
                  <div class="absolute bottom-2 left-2">
                    <div class="flex items-center gap-1 bg-black bg-opacity-75 text-white px-2 py-1 rounded-full text-xs lg:text-sm">
                      <.icon name="hero-star" class="w-4 h-4 text-yellow-400" />
                      {Float.round(title["vote_average"], 1)}
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <!-- Multiple Content Sections -->
      <div class="space-y-0">
        <!-- Trending Movies Section -->
        <div class="max-w-7xl mx-auto px-4 lg:px-6 pt-16 lg:pt-6">
          <div class="flex items-center gap-4 pb-6 lg:pb-8">
            <div class="flex items-center gap-3">
              <div class="w-2 h-8 lg:h-10 bg-gradient-to-b from-orange-400 via-orange-500 to-red-600 rounded-full shadow-lg">
              </div>
              <div class="w-1 h-6 lg:h-8 bg-gradient-to-b from-red-500 to-pink-600 rounded-full opacity-60">
              </div>
            </div>
            <h3 class="text-white text-xl lg:text-2xl font-bold leading-tight tracking-[-0.02em] bg-gradient-to-r from-orange-400 to-red-500 bg-clip-text text-transparent">
              Filmes em Alta
            </h3>
            <div class="flex-1"></div>
            <div class="hidden lg:flex items-center gap-2 text-gray-400 text-sm">
              <div class="w-2 h-2 bg-orange-500 rounded-full animate-pulse"></div>
              <span>Trending</span>
            </div>
          </div>
          <div class="grid grid-cols-3 gap-3 lg:gap-4 p-2 lg:p-4">
            <%= for title <- Enum.take(@trending_movies, 9) do %>
              <div class="flex flex-col gap-2 lg:gap-3">
                <div class="relative group">
                  <div
                    class="w-full bg-center bg-no-repeat aspect-[2/3] bg-cover rounded-xl cursor-pointer hover:opacity-90 transition-opacity"
                    style={"background-image: url(#{title["poster_path"] && "https://image.tmdb.org/t/p/w500#{title["poster_path"]}"})"}
                    phx-click="navigate_to_title"
                    phx-value-title={Jason.encode!(title)}
                  >
                  </div>
                  <div class="absolute top-2 right-2">
                    <button
                      phx-click="show_add_to_lists_modal"
                      phx-value-title={Jason.encode!(title)}
                      class="bg-blue-600 text-white w-8 h-8 rounded-full shadow-lg opacity-80 hover:opacity-100 transition-all duration-200 flex items-center justify-center"
                      title="Adicionar às Listas"
                    >
                      <.icon name="hero-plus" class="w-4 h-4" />
                    </button>
                  </div>
                  <!-- Rating Badge -->
                  <%= if title["vote_average"] != nil and title["vote_average"] > 0 do %>
                    <div class="absolute bottom-2 left-2">
                      <div class="flex items-center gap-1 bg-black bg-opacity-75 text-white px-2 py-1 rounded-full text-xs lg:text-sm">
                        <.icon name="hero-star" class="w-4 h-4 text-yellow-400" />
                        {Float.round(title["vote_average"], 1)}
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        
<!-- Popular TV Shows Section -->
        <div class="max-w-7xl mx-auto px-4 lg:px-6 pt-8 lg:pt-12">
          <div class="flex items-center gap-4 pb-6 lg:pb-8">
            <div class="flex items-center gap-3">
              <div class="w-2 h-8 lg:h-10 bg-gradient-to-b from-green-400 via-green-500 to-teal-600 rounded-full shadow-lg">
              </div>
              <div class="w-1 h-6 lg:h-8 bg-gradient-to-b from-teal-500 to-blue-600 rounded-full opacity-60">
              </div>
            </div>
            <h3 class="text-white text-xl lg:text-2xl font-bold leading-tight tracking-[-0.02em] bg-gradient-to-r from-green-400 to-teal-500 bg-clip-text text-transparent">
              Séries Populares
            </h3>
            <div class="flex-1"></div>
            <div class="hidden lg:flex items-center gap-2 text-gray-400 text-sm">
              <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
              <span>Popular</span>
            </div>
          </div>
          <div class="grid grid-cols-3 gap-3 lg:gap-4 p-2 lg:p-4">
            <%= for title <- Enum.take(@trending_tv_shows || [], 9) do %>
              <div class="flex flex-col gap-2 lg:gap-3">
                <div class="relative group">
                  <div
                    class="w-full bg-center bg-no-repeat aspect-[2/3] bg-cover rounded-xl cursor-pointer hover:opacity-90 transition-opacity"
                    style={"background-image: url(#{title["poster_path"] && "https://image.tmdb.org/t/p/w500#{title["poster_path"]}"})"}
                    phx-click="navigate_to_title"
                    phx-value-title={Jason.encode!(title)}
                  >
                  </div>
                  <div class="absolute top-2 right-2">
                    <button
                      phx-click="show_add_to_lists_modal"
                      phx-value-title={Jason.encode!(title)}
                      class="bg-blue-600 text-white w-8 h-8 rounded-full shadow-lg opacity-80 hover:opacity-100 transition-all duration-200 flex items-center justify-center"
                      title="Adicionar às Listas"
                    >
                      <.icon name="hero-plus" class="w-4 h-4" />
                    </button>
                  </div>
                  <!-- Rating Badge -->
                  <%= if title["vote_average"] != nil and title["vote_average"] > 0 do %>
                    <div class="absolute bottom-2 left-2">
                      <div class="flex items-center gap-1 bg-black bg-opacity-75 text-white px-2 py-1 rounded-full text-xs lg:text-sm">
                        <.icon name="hero-star" class="w-4 h-4 text-yellow-400" />
                        {Float.round(title["vote_average"], 1)}
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        
<!-- Recent Releases Section -->
        <div class="max-w-7xl mx-auto px-4 lg:px-6 pt-8 lg:pt-12">
          <div class="flex items-center gap-4 pb-6 lg:pb-8">
            <div class="flex items-center gap-3">
              <div class="w-2 h-8 lg:h-10 bg-gradient-to-b from-purple-400 via-purple-500 to-pink-600 rounded-full shadow-lg">
              </div>
              <div class="w-1 h-6 lg:h-8 bg-gradient-to-b from-pink-500 to-rose-600 rounded-full opacity-60">
              </div>
            </div>
            <h3 class="text-white text-xl lg:text-2xl font-bold leading-tight tracking-[-0.02em] bg-gradient-to-r from-purple-400 to-pink-500 bg-clip-text text-transparent">
              Lançamentos Recentes
            </h3>
            <div class="flex-1"></div>
            <div class="hidden lg:flex items-center gap-2 text-gray-400 text-sm">
              <div class="w-2 h-2 bg-purple-500 rounded-full animate-pulse"></div>
              <span>New</span>
            </div>
          </div>
          <div class="grid grid-cols-3 gap-3 lg:gap-4 p-2 lg:p-4">
            <%= for title <- Enum.take(@recent_releases || [], 9) do %>
              <div class="flex flex-col gap-2 lg:gap-3">
                <div class="relative group">
                  <div
                    class="w-full bg-center bg-no-repeat aspect-[2/3] bg-cover rounded-xl cursor-pointer hover:opacity-90 transition-opacity"
                    style={"background-image: url(#{title["poster_path"] && "https://image.tmdb.org/t/p/w500#{title["poster_path"]}"})"}
                    phx-click="navigate_to_title"
                    phx-value-title={Jason.encode!(title)}
                  >
                  </div>
                  <div class="absolute top-2 right-2">
                    <button
                      phx-click="show_add_to_lists_modal"
                      phx-value-title={Jason.encode!(title)}
                      class="bg-blue-600 text-white w-8 h-8 rounded-full shadow-lg opacity-80 hover:opacity-100 transition-all duration-200 flex items-center justify-center"
                      title="Adicionar às Listas"
                    >
                      <.icon name="hero-plus" class="w-4 h-4" />
                    </button>
                  </div>
                  <!-- Rating Badge -->
                  <%= if title["vote_average"] != nil and title["vote_average"] > 0 do %>
                    <div class="absolute bottom-2 left-2">
                      <div class="flex items-center gap-1 bg-black bg-opacity-75 text-white px-2 py-1 rounded-full text-xs lg:text-sm">
                        <.icon name="hero-star" class="w-4 h-4 text-yellow-400" />
                        {Float.round(title["vote_average"], 1)}
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        
<!-- Top Rated Section -->
        <div class="max-w-7xl mx-auto px-4 lg:px-6 pt-8 lg:pt-12">
          <div class="flex items-center gap-4 pb-6 lg:pb-8">
            <div class="flex items-center gap-3">
              <div class="w-2 h-8 lg:h-10 bg-gradient-to-b from-yellow-400 via-yellow-500 to-orange-600 rounded-full shadow-lg">
              </div>
              <div class="w-1 h-6 lg:h-8 bg-gradient-to-b from-orange-500 to-red-600 rounded-full opacity-60">
              </div>
            </div>
            <h3 class="text-white text-xl lg:text-2xl font-bold leading-tight tracking-[-0.02em] bg-gradient-to-r from-yellow-400 to-orange-500 bg-clip-text text-transparent">
              Melhores Avaliados
            </h3>
            <div class="flex-1"></div>
            <div class="hidden lg:flex items-center gap-2 text-gray-400 text-sm">
              <div class="w-2 h-2 bg-yellow-500 rounded-full animate-pulse"></div>
              <span>Top Rated</span>
            </div>
          </div>
          <div class="grid grid-cols-3 gap-3 lg:gap-4 p-2 lg:p-4">
            <%= for title <- Enum.take(@top_rated || [], 9) do %>
              <div class="flex flex-col gap-2 lg:gap-3">
                <div class="relative group">
                  <div
                    class="w-full bg-center bg-no-repeat aspect-[2/3] bg-cover rounded-xl cursor-pointer hover:opacity-90 transition-opacity"
                    style={"background-image: url(#{title["poster_path"] && "https://image.tmdb.org/t/p/w500#{title["poster_path"]}"})"}
                    phx-click="navigate_to_title"
                    phx-value-title={Jason.encode!(title)}
                  >
                  </div>
                  <div class="absolute top-2 right-2">
                    <button
                      phx-click="show_add_to_lists_modal"
                      phx-value-title={Jason.encode!(title)}
                      class="bg-blue-600 text-white w-8 h-8 rounded-full shadow-lg opacity-80 hover:opacity-100 transition-all duration-200 flex items-center justify-center"
                      title="Adicionar às Listas"
                    >
                      <.icon name="hero-plus" class="w-4 h-4" />
                    </button>
                  </div>
                  <!-- Rating Badge -->
                  <%= if title["vote_average"] != nil and title["vote_average"] > 0 do %>
                    <div class="absolute bottom-2 left-2">
                      <div class="flex items-center gap-1 bg-black bg-opacity-75 text-white px-2 py-1 rounded-full text-xs lg:text-sm">
                        <.icon name="hero-star" class="w-4 h-4 text-yellow-400" />
                        {Float.round(title["vote_average"], 1)}
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        
<!-- Genre Sections with Infinite Scroll -->
        <%= if @streams.genre_sections do %>
          <div id="genre-sections" phx-update="stream">
            <%= for {dom_id, genre_section} <- @streams.genre_sections do %>
              <div id={dom_id} class="max-w-7xl mx-auto px-4 lg:px-6 pt-8 lg:pt-12">
                <div class="flex items-center gap-4 pb-6 lg:pb-8">
                  <div class="flex items-center gap-3">
                    <div class="w-2 h-8 lg:h-10 bg-gradient-to-b from-blue-400 via-blue-500 to-purple-600 rounded-full shadow-lg">
                    </div>
                    <div class="w-1 h-6 lg:h-8 bg-gradient-to-b from-purple-500 to-indigo-600 rounded-full opacity-60">
                    </div>
                  </div>
                  <h3 class="text-white text-xl lg:text-2xl font-bold leading-tight tracking-[-0.02em] bg-gradient-to-r from-blue-400 to-purple-500 bg-clip-text text-transparent">
                    {genre_section.genre.name}
                  </h3>
                  <div class="flex-1"></div>
                  <div class="hidden lg:flex items-center gap-2 text-gray-400 text-sm">
                    <div class="w-2 h-2 bg-blue-500 rounded-full animate-pulse"></div>
                    <span>Genre</span>
                  </div>
                </div>
                <div class="grid grid-cols-3 gap-3 lg:gap-4 p-2 lg:p-4">
                  <%= for title <- genre_section.titles || [] do %>
                    <div class="flex flex-col gap-2 lg:gap-3">
                      <div class="relative group">
                        <div
                          class="w-full bg-center bg-no-repeat aspect-[2/3] bg-cover rounded-xl cursor-pointer hover:opacity-90 transition-opacity"
                          style={"background-image: url(#{title["poster_path"] && "https://image.tmdb.org/t/p/w500#{title["poster_path"]}"})"}
                          phx-click="navigate_to_title"
                          phx-value-title={Jason.encode!(title)}
                        >
                        </div>
                        <div class="absolute top-2 right-2">
                          <button
                            phx-click="show_add_to_lists_modal"
                            phx-value-title={Jason.encode!(title)}
                            class="bg-blue-600 text-white w-8 h-8 rounded-full shadow-lg opacity-80 hover:opacity-100 transition-all duration-200 flex items-center justify-center"
                            title="Adicionar às Listas"
                          >
                            <.icon name="hero-plus" class="w-4 h-4" />
                          </button>
                        </div>
                        <!-- Rating Badge -->
                        <%= if title["vote_average"] != nil and title["vote_average"] > 0 do %>
                          <div class="absolute bottom-2 left-2">
                            <div class="flex items-center gap-1 bg-black bg-opacity-75 text-white px-2 py-1 rounded-full text-xs lg:text-sm">
                              <.icon name="hero-star" class="w-4 h-4 text-yellow-400" />
                              {Float.round(title["vote_average"], 1)}
                            </div>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
        
<!-- Loading Indicator and Intersection Observer Target -->
        <%= if @loaded_genres_count < @max_genres and @available_genres && length(@available_genres) > @loaded_genres_count do %>
          <div class="max-w-7xl mx-auto px-4 lg:px-6">
            <!-- Ver Mais button -->
            <div class="flex justify-center mb-4">
              <button
                phx-click="load_more_genres"
                class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
              >
                Ver Mais
              </button>
            </div>

            <div
              id="intersection-observer-target"
              phx-hook="IntersectionObserver"
              data-load-more="true"
            />
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  
<!-- Bottom Navigation Component -->
  <.bottom_navigation current_page={@current_page} />
</div>

<!-- Add to Lists Modal -->
<%= if @show_modal do %>
  <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-[#1a1a1a] rounded-lg p-6 max-w-md w-full mx-4 max-h-[80vh] overflow-y-auto">
      <!-- Modal Header -->
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-white text-lg font-bold">Adicionar às Listas</h3>
        <button phx-click="close_modal" class="text-gray-400 hover:text-white transition-colors">
          <.icon name="hero-x-mark" class="w-6 h-6" />
        </button>
      </div>
      
<!-- Selected Title Info -->
      <%= if @selected_title do %>
        <div class="flex items-center gap-3 mb-4 p-3 bg-[#2a2a2a] rounded-lg">
          <div
            class="w-16 h-24 bg-center bg-no-repeat bg-cover rounded"
            style={"background-image: url(\"https://image.tmdb.org/t/p/w200#{@selected_title["poster_path"]}\");"}
          >
          </div>
          <div class="flex-1">
            <h4 class="text-white font-semibold">
              {@selected_title["title"] || @selected_title["name"]}
            </h4>
            <p class="text-gray-400 text-sm">
              {@selected_title["release_date"] || @selected_title["first_air_date"]}
            </p>
          </div>
        </div>
      <% end %>
      
<!-- Lists Selection -->
      <div class="mb-4">
        <h4 class="text-white font-medium mb-3">Selecione as listas:</h4>
        <div class="space-y-2 max-h-60 overflow-y-auto">
          <%= for list <- @user_lists do %>
            <label class="flex items-center gap-3 p-3 bg-[#2a2a2a] rounded-lg cursor-pointer hover:bg-[#333333] transition-colors">
              <input
                type="checkbox"
                value={list.id}
                checked={to_string(list.id) in @selected_lists}
                phx-click="toggle_list_selection"
                phx-value-list_id={list.id}
                class="w-4 h-4 text-blue-600 bg-gray-700 border-gray-600 rounded focus:ring-blue-500 focus:ring-2"
              />
              <div class="flex-1">
                <p class="text-white font-medium">{list.name}</p>
                <p class="text-gray-400 text-sm">{length(list.list_items || [])} itens</p>
              </div>
            </label>
          <% end %>
        </div>
      </div>
      
<!-- Modal Actions -->
      <div class="flex gap-3">
        <button
          phx-click="close_modal"
          class="flex-1 px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors"
        >
          Cancelar
        </button>
        <button
          phx-click="add_to_selected_lists"
          disabled={length(@selected_lists) == 0}
          class="flex-1 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Adicionar ({length(@selected_lists)})
        </button>
      </div>
    </div>
  </div>
<% end %>
