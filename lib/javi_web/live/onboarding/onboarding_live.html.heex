<div class="relative h-screen bg-[#141414] overflow-hidden">
  <!-- Animated Background -->
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-gradient-to-br from-[#1a1a1a] via-[#141414] to-[#0a0a0a]">
    </div>
    <div class="absolute inset-0">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-500/5 rounded-full blur-3xl animate-pulse">
      </div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-purple-500/5 rounded-full blur-3xl animate-pulse delay-1000">
      </div>
      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-green-500/5 rounded-full blur-3xl animate-pulse delay-2000">
      </div>
    </div>
  </div>
  
<!-- Multiple Animated Objects -->
  <div class="absolute inset-0 pointer-events-none z-10">
    <!-- Floating Object Top Left -->
    <div class="floating-object-top-left">
      <div
        class="w-6 h-6 bg-gradient-to-r from-green-400 to-teal-400 rounded-full shadow-lg animate-float cursor-pointer hover:scale-150 transition-transform"
        phx-click="object_click"
        phx-value-object="floater1"
      >
      </div>
    </div>
    
<!-- Floating Object Top Right -->
    <div class="floating-object-top-right">
      <div
        class="w-5 h-5 bg-gradient-to-r from-pink-400 to-red-400 rounded-full shadow-lg animate-float-delayed cursor-pointer hover:scale-150 transition-transform"
        phx-click="object_click"
        phx-value-object="floater2"
      >
      </div>
    </div>
    
<!-- Bouncing Object Bottom Left -->
    <div class="bouncing-object-bottom-left">
      <div
        class="w-7 h-7 bg-gradient-to-r from-yellow-400 to-orange-400 rounded-full shadow-lg animate-bounce cursor-pointer hover:scale-150 transition-transform"
        phx-click="object_click"
        phx-value-object="bouncer"
      >
      </div>
    </div>
    
<!-- Spinning Object Top Center -->
    <div class="spinning-object-top-center">
      <div
        class="w-6 h-6 bg-gradient-to-r from-cyan-400 to-blue-400 rounded-full shadow-lg animate-spin cursor-pointer hover:scale-150 transition-transform"
        phx-click="object_click"
        phx-value-object="spinner"
      >
      </div>
    </div>
    
<!-- Pulsing Object Bottom Right -->
    <div class="pulsing-object-bottom-right">
      <div
        class="w-5 h-5 bg-gradient-to-r from-purple-400 to-pink-400 rounded-full shadow-lg animate-pulse cursor-pointer hover:scale-150 transition-transform"
        phx-click="object_click"
        phx-value-object="pulser"
      >
      </div>
    </div>
    
<!-- Floating Object Middle Right -->
    <div class="floating-object-middle-right">
      <div
        class="w-4 h-4 bg-gradient-to-r from-indigo-400 to-purple-400 rounded-full shadow-lg animate-float-slow cursor-pointer hover:scale-150 transition-transform"
        phx-click="object_click"
        phx-value-object="floater3"
      >
      </div>
    </div>
    
<!-- New Object 1 - Top Middle Left -->
    <div class="new-object-top-middle-left">
      <div
        class="w-5 h-5 bg-gradient-to-r from-emerald-400 to-green-400 rounded-full shadow-lg animate-float-slow-delayed cursor-pointer hover:scale-150 transition-transform"
        phx-click="object_click"
        phx-value-object="new1"
      >
      </div>
    </div>
    
<!-- New Object 2 - Bottom Middle -->
    <div class="new-object-bottom-middle">
      <div
        class="w-6 h-6 bg-gradient-to-r from-rose-400 to-pink-400 rounded-full shadow-lg animate-bounce-slow cursor-pointer hover:scale-150 transition-transform"
        phx-click="object_click"
        phx-value-object="new2"
      >
      </div>
    </div>
    
<!-- New Object 3 - Top Left Corner -->
    <div class="new-object-top-left-corner">
      <div
        class="w-4 h-4 bg-gradient-to-r from-blue-400 to-indigo-400 rounded-full shadow-lg animate-float cursor-pointer hover:scale-150 transition-transform"
        phx-click="object_click"
        phx-value-object="new3"
      >
      </div>
    </div>
    
<!-- New Object 4 - Top Right Corner -->
    <div class="new-object-top-right-corner">
      <div
        class="w-5 h-5 bg-gradient-to-r from-orange-400 to-red-400 rounded-full shadow-lg animate-bounce cursor-pointer hover:scale-150 transition-transform"
        phx-click="object_click"
        phx-value-object="new4"
      >
      </div>
    </div>
    
<!-- New Object 6 - Middle Top -->
    <div class="new-object-middle-top">
      <div
        class="w-4 h-4 bg-gradient-to-r from-violet-400 to-purple-400 rounded-full shadow-lg animate-pulse cursor-pointer hover:scale-150 transition-transform"
        phx-click="object_click"
        phx-value-object="new6"
      >
      </div>
    </div>
    
<!-- New Object 7 - Bottom Left Corner -->
    <div class="new-object-bottom-left-corner">
      <div
        class="w-5 h-5 bg-gradient-to-r from-lime-400 to-green-400 rounded-full shadow-lg animate-float-delayed cursor-pointer hover:scale-150 transition-transform"
        phx-click="object_click"
        phx-value-object="new7"
      >
      </div>
    </div>
    
<!-- New Object 8 - Bottom Right Corner -->
    <div class="new-object-bottom-right-corner">
      <div
        class="w-6 h-6 bg-gradient-to-r from-fuchsia-400 to-pink-400 rounded-full shadow-lg animate-bounce-slow cursor-pointer hover:scale-150 transition-transform"
        phx-click="object_click"
        phx-value-object="new8"
      >
      </div>
    </div>
    
<!-- New Object 9 - Far Left Middle -->
    <div class="new-object-far-left-middle">
      <div
        class="w-4 h-4 bg-gradient-to-r from-amber-400 to-yellow-400 rounded-full shadow-lg animate-float-slow cursor-pointer hover:scale-150 transition-transform"
        phx-click="object_click"
        phx-value-object="new9"
      >
      </div>
    </div>
    
<!-- New Object 10 - Far Right Middle -->
    <div class="new-object-far-right-middle">
      <div
        class="w-5 h-5 bg-gradient-to-r from-sky-400 to-blue-400 rounded-full shadow-lg animate-spin cursor-pointer hover:scale-150 transition-transform"
        phx-click="object_click"
        phx-value-object="new10"
      >
      </div>
    </div>
  </div>
  
<!-- Fixed Header -->
  <div class="fixed top-0 left-0 right-0 z-50 flex justify-between items-center p-6">
    <!-- Audio Controls -->
    <button
      id="audio-control"
      phx-click="toggle_audio"
      phx-hook="AudioControl"
      data-audio-playing={@audio_playing}
      class="px-4 py-2 bg-white/5 backdrop-blur-lg text-white/70 rounded-full font-medium hover:bg-white/10 hover:text-white transition-all duration-300 border border-white/10 flex items-center gap-2"
    >
      <.icon name="hero-musical-note" class="w-5 h-5" />
      {if @audio_playing, do: "Pausar", else: "Tocar"}
    </button>
    
<!-- Skip Button -->
    <button
      phx-click="skip_onboarding"
      class="px-4 py-2 bg-white/5 backdrop-blur-lg text-white/70 rounded-full font-medium hover:bg-white/10 hover:text-white transition-all duration-300 border border-white/10"
    >
      Pular
    </button>
  </div>
  
<!-- Hidden Audio Element -->
  <audio id="onboarding-audio" loop class="hidden">
    <source src="/audio/funky-vibes-beat.mp3" type="audio/mpeg" />
    Seu navegador não suporta o elemento de áudio.
  </audio>
  
<!-- Main Content Area -->
  <div class="relative z-20 flex flex-col h-screen">
    <!-- Scrollable Content Area -->
    <div class="flex-1 overflow-y-auto">
      <div class="flex items-center justify-center px-4 pb-20 pt-4 lg:p-12 h-full">
        <div class="w-full max-w-6xl h-full flex items-center">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-12 items-center w-full h-full">
            
<!-- Left Side - Content -->
            <div class="space-y-4 lg:space-y-6 flex flex-col justify-center">
              <%= for {step, index} <- Enum.with_index(@onboarding_data) do %>
                <div
                  class={"transition-all duration-1000 ease-in-out #{if @current_step == index, do: "opacity-100 translate-y-0", else: "opacity-0 translate-y-8 absolute"}"}
                  style={"z-index: #{if @current_step == index, do: "10", else: "0"}"}
                >
                  <!-- Title -->
                  <h1 class="text-3xl lg:text-6xl xl:text-7xl 2xl:text-8xl font-bold text-white mb-4 lg:mb-6 leading-tight">
                    {step.title}
                  </h1>
                  
<!-- Subtitle -->
                  <h2 class="text-lg lg:text-2xl xl:text-3xl 2xl:text-4xl font-medium text-gray-300 mb-6 lg:mb-8">
                    {step.subtitle}
                  </h2>
                  
<!-- PWA Installation Content for Step 6 -->
                  <%= if index == 5 do %>
                    <div class="space-y-4 lg:space-y-6">
                      <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-4 lg:p-6 border border-white/10">
                        <div class="flex items-center space-x-3 lg:space-x-4 mb-3 lg:mb-4">
                          <div class="w-10 h-10 lg:w-12 lg:h-12 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl flex items-center justify-center">
                            <svg
                              class="w-5 h-5 lg:w-6 lg:h-6 text-white"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                              >
                              </path>
                            </svg>
                          </div>
                          <div>
                            <h3 class="text-lg lg:text-xl font-semibold text-white">
                              Instalar App
                            </h3>
                            <p class="text-gray-400 text-sm lg:text-base">
                              Tenha acesso rápido e offline
                            </p>
                          </div>
                        </div>

                        <div class="space-y-3 lg:space-y-4">
                          <div class="flex items-center space-x-3">
                            <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                            <span class="text-gray-300 text-sm lg:text-base">
                              Acesso offline aos seus dados
                            </span>
                          </div>
                          <div class="flex items-center space-x-3">
                            <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                            <span class="text-gray-300 text-sm lg:text-base">
                              Carregamento mais rápido
                            </span>
                          </div>
                          <div class="flex items-center space-x-3">
                            <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                            <span class="text-gray-300 text-sm lg:text-base">
                              Experiência nativa
                            </span>
                          </div>
                          <div class="flex items-center space-x-3">
                            <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                            <span class="text-gray-300 text-sm lg:text-base">
                              Notificações push
                            </span>
                          </div>
                        </div>

                        <div class="mt-4 lg:mt-6 space-y-3">
                          <%= if @pwa_installable do %>
                            <button
                              id="pwa-install-btn-onboarding"
                              class="w-full bg-gradient-to-r from-purple-600 to-pink-600 text-white font-semibold py-3 px-6 rounded-xl hover:shadow-lg transform hover:scale-105 transition-all duration-300 flex items-center justify-center space-x-2"
                            >
                              <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                                >
                                </path>
                              </svg>
                              <span>Instalar App</span>
                            </button>
                          <% else %>
                            <div class="text-center py-4">
                              <div class="w-12 h-12 lg:w-16 lg:h-16 bg-gray-600 rounded-full flex items-center justify-center mx-auto mb-3">
                                <svg
                                  class="w-6 h-6 lg:w-8 lg:h-8 text-gray-400"
                                  fill="none"
                                  stroke="currentColor"
                                  viewBox="0 0 24 24"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12"
                                  >
                                  </path>
                                </svg>
                              </div>
                              <p class="text-gray-400 text-sm">
                                App não disponível para instalação
                              </p>
                              <p class="text-gray-500 text-xs mt-1">
                                Tente em um navegador compatível
                              </p>
                            </div>
                          <% end %>

                          <%= if @pwa_installed do %>
                            <div class="bg-green-500/10 border border-green-500/20 rounded-xl p-4 text-center">
                              <div class="flex items-center justify-center space-x-2 text-green-400">
                                <svg
                                  class="w-5 h-5"
                                  fill="none"
                                  stroke="currentColor"
                                  viewBox="0 0 24 24"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"
                                  >
                                  </path>
                                </svg>
                                <span class="font-semibold text-sm lg:text-base">
                                  App instalado com sucesso!
                                </span>
                              </div>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
            
<!-- Right Side - Image -->
            <div class="relative flex items-center justify-center h-full">
              <%= for {step, index} <- Enum.with_index(@onboarding_data) do %>
                <div
                  class={"#{if @current_step == index, do: "opacity-100", else: "opacity-0 absolute"}"}
                  style={"z-index: #{if @current_step == index, do: "10", else: "0"}"}
                >
                  <div class="relative w-full h-full flex items-center justify-center">
                    <!-- Main Image with Background Color -->
                    <div class="relative rounded-xl overflow-hidden shadow-2xl w-full max-w-xllg:max-w-lg">
                      <!-- Background Color Overlay -->
                      <div class={"absolute inset-0 bg-gradient-to-br #{step.bg_color} opacity-30 z-0"}>
                      </div>
                      
<!-- Image Overlay -->
                      <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent z-10">
                      </div>

                      <img
                        src={step.image}
                        alt={step.title}
                        class="w-full h-[350px] lg:h-[500px] object-cover relative z-5"
                        loading="lazy"
                      />
                      
<!-- Overlay Content -->
                      <div class="absolute bottom-0 left-0 right-0 p-3 lg:p-6 z-20">
                        <div class="bg-black/30 backdrop-blur-lg rounded-lg p-2 lg:p-4">
                          <h3 class="text-xl lg:text-3xl xl:text-4xl 2xl:text-5xl font-bold text-white mb-2 lg:mb-3">
                            {step.overlay_title}
                          </h3>
                          <p class="text-gray-300 text-sm lg:text-lg xl:text-xl 2xl:text-2xl">
                            {step.overlay_subtitle}
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
<!-- Fixed Bottom Navigation -->
  <div class="fixed bottom-0 left-0 right-0 z-50 bg-[#0a0a0a]/80 backdrop-blur-lg border-t border-white/10">
    <div class="max-w-6xl mx-auto p-6 lg:p-8">
      <!-- Progress Bar -->
      <div class="mb-6">
        <div class="w-full bg-gray-800 rounded-full h-1">
          <div
            class="h-1 bg-gradient-to-r from-blue-500 to-purple-500 rounded-full transition-all duration-500 ease-out"
            style={"width: #{(@current_step + 1) / @total_steps * 100}%"}
          >
          </div>
        </div>
      </div>
      
<!-- Navigation Buttons -->
      <div class="flex items-center justify-between">
        <button
          phx-click="previous_step"
          class={"px-4 py-2 rounded-lg font-medium transition-all duration-300 #{if @current_step > 0, do: "bg-white/5 text-white/70 hover:bg-white/10 hover:text-white", else: "bg-transparent text-gray-500 cursor-not-allowed"}"}
          disabled={@current_step == 0}
        >
          Anterior
        </button>
        
<!-- Dots Navigation -->
        <div class="flex space-x-2">
          <%= for i <- 0..(@total_steps - 1) do %>
            <button
              class={"w-2 h-2 rounded-full transition-all duration-300 #{if @current_step == i, do: "bg-white scale-125", else: "bg-white/20 hover:bg-white/40"}"}
              phx-click="go_to_step"
              phx-value-step={i}
            >
            </button>
          <% end %>
        </div>

        <div class="flex items-center space-x-3">
          <%= if @current_step == 5 do %>
            <button
              phx-click="skip_pwa_install"
              class="px-4 py-2 text-gray-400 hover:text-white transition-colors duration-300"
            >
              Pular
            </button>
          <% end %>

          <button
            phx-click="next_step"
            class="px-6 py-2 bg-gradient-to-r from-blue-500 to-purple-500 text-white rounded-lg font-medium hover:from-blue-600 hover:to-purple-600 transition-all duration-300 transform hover:scale-105 shadow-lg"
          >
            {if @current_step == @total_steps - 1, do: "Começar", else: "Próximo"}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
