<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center px-4">
  <div class="max-w-md w-full bg-white rounded-2xl shadow-xl p-8 text-center">
    <!-- 404 Icon -->
    <div class="mb-8">
      <div class="mx-auto w-24 h-24 bg-gradient-to-br from-red-400 to-red-600 rounded-full flex items-center justify-center">
        <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"
          >
          </path>
        </svg>
      </div>
    </div>
    
<!-- Error Message -->
    <h1 class="text-6xl font-bold text-gray-800 mb-4">404</h1>
    <h2 class="text-2xl font-semibold text-gray-700 mb-4">Página não encontrada</h2>
    <p class="text-gray-600 mb-8">
      A página que você está procurando não existe ou foi movida.
    </p>
    
<!-- Action Buttons -->
    <div class="space-y-4">
      <a
        href="/"
        class="inline-block w-full bg-gradient-to-r from-blue-500 to-indigo-600 text-white font-semibold py-3 px-6 rounded-lg hover:from-blue-600 hover:to-indigo-700 transition-all duration-200 transform hover:scale-105"
      >
        Voltar ao início
      </a>

      <a
        href="/entrar"
        class="inline-block w-full bg-gray-100 text-gray-700 font-semibold py-3 px-6 rounded-lg hover:bg-gray-200 transition-all duration-200"
      >
        Fazer login
      </a>
    </div>
    
<!-- Helpful Links -->
    <div class="mt-8 pt-6 border-t border-gray-200">
      <p class="text-sm text-gray-500 mb-4">Páginas populares:</p>
      <div class="flex flex-wrap justify-center gap-2">
        <a href="/inicio" class="text-sm text-blue-600 hover:text-blue-800 hover:underline">
          Dashboard
        </a>
        <span class="text-gray-400">•</span>
        <a href="/pesquisar" class="text-sm text-blue-600 hover:text-blue-800 hover:underline">
          Pesquisar
        </a>
        <span class="text-gray-400">•</span>
        <a href="/listas" class="text-sm text-blue-600 hover:text-blue-800 hover:underline">
          Listas
        </a>
        <span class="text-gray-400">•</span>
        <a href="/perfil" class="text-sm text-blue-600 hover:text-blue-800 hover:underline">
          Perfil
        </a>
      </div>
    </div>
  </div>
</div>
